#!/usr/bin/env bash
set -euo pipefail

# Delta cannot detect the terminal background reliably when LazyGit pipes its
# output: https://github.com/dandavison/delta/issues/1968
dark_light_flag() {
  if [[ $(uname -s) == Darwin ]]; then
    if [[ $(defaults read -g AppleInterfaceStyle 2>/dev/null || true) == Dark ]]; then
      printf '%s\n' --dark
    else
      printf '%s\n' --light
    fi
    return
  fi

  if command -v gsettings >/dev/null 2>&1; then
    case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || true)" in
    *prefer-dark*) printf '%s\n' --dark; return ;;
    *prefer-light*) printf '%s\n' --light; return ;;
    esac

    case "$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null || true)" in
    *-dark* | *Dark*) printf '%s\n' --dark; return ;;
    esac
  fi

  printf '%s\n' --light
}

exec delta "$(dark_light_flag)" "$@"
