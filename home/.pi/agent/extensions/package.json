{
	"name": "extensions",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "oxlint --type-aware --report-unused-disable-directives --max-warnings 0",
		"deadcode": "knip",
		"test:extensions": "node --test --test-reporter=dot '**/tests/*.test.ts' '**/tests/*.test.mjs'",
		"test": "pnpm run test:extensions",
		"peers:check": "pnpm peers check",
		"check": "pnpm run peers:check && pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run deadcode && pnpm test"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^1.0.4",
		"@earendil-works/pi-coding-agent": "^1.0.4",
		"@earendil-works/pi-tui": "^1.0.4",
		"effect": "4.0.1",
		"smol-toml": "1.9.0",
		"typebox": "^1.3.35"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"fast-check": "^4.10.2",
		"knip": "^6.39.0",
		"oxfmt": "0.72.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=26.0.0"
	},
	"packageManager": "pnpm@12",
	"knip": {
		"ignoreExportsUsedInFile": true,
		"entry": [
			"index.ts",
			"**/tests/*.test.ts",
			"tests/*.test.ts"
		],
		"project": [
			"**/*.ts",
			"**/*.mjs"
		]
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	}
}
