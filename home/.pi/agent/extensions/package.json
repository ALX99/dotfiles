{
	"name": "extensions",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "oxlint --type-aware --report-unused-disable-directives --max-warnings 0",
		"deadcode": "knip",
		"test:extensions": "node --test '**/tests/*.test.ts' '**/tests/*.test.mjs'",
		"test": "pnpm run test:extensions",
		"peers:check": "pnpm peers check",
		"check": "pnpm run peers:check && pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run deadcode && pnpm test"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.82.0",
		"@earendil-works/pi-coding-agent": "0.82.0",
		"@earendil-works/pi-tui": "0.82.0",
		"execa": "^10.0.0",
		"neverthrow": "^8.2.0",
		"typebox": "^1.3.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"fast-check": "^4.9.0",
		"knip": "^6.27.0",
		"oxfmt": "0.59.0",
		"oxlint": "^1.74.0",
		"oxlint-tsgolint": "0.25.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=26.0.0"
	},
	"knip": {
		"ignoreExportsUsedInFile": true,
		"entry": [
			"*.ts",
			"*/index.ts",
			"**/tests/*.test.ts"
		],
		"project": [
			"**/*.ts",
			"**/*.mjs"
		]
	}
}
