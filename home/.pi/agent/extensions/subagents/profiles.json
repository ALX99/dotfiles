			"defaultProfile": "fast",
			"allowedProfiles": ["fast"]
		},
		"worker": {
			"defaultProfile": "balanced",
			"allowedProfiles": ["fast", "balanced"]
		},
		"general": {
			"defaultProfile": "balanced",
			"allowedProfiles": ["fast", "balanced"]
		}
	}
