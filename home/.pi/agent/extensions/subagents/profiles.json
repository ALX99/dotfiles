{
	"rootPolicy": {
		"maxConcurrentRootAgents": 10
	},
	"capabilityRanking": [
		"opencode/muse-spark-1.3-contributor-free",
		"openai-codex/gpt-5.6-luna",
		"openai-codex/gpt-5.6-terra",
		"openai-codex/gpt-5.6-sol",
		"openai-codex/gpt-5.6-astra"
	],
	"profiles": {
		"fast": {
			"description": "Fast, economical bounded mechanical work, well-scoped implementation, lookups, or bulk simple changes with known success criteria",
			"modelPriority": [
				{ "id": "openai-codex/gpt-5.6-luna", "defaultThinking": "xhigh", "maxThinking": "max" },
				{ "id": "opencode/muse-spark-1.3-contributor-free", "defaultThinking": "xhigh", "maxThinking": "xhigh" }
			]
		},
		"balanced": {
			"description": "Default for judgment work: debugging, review, design, ambiguous investigation, and final correctness",
			"modelPriority": [{ "id": "openai-codex/gpt-5.6-terra", "defaultThinking": "medium", "maxThinking": "max" }]
		}
	},
	"agentPolicies": {
