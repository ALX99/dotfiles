#!/usr/bin/env bun
// Run a command with srt's static policy plus workspace and host-specific rules.
// vim: set ft=javascript:

import { execFileSync, spawn } from "node:child_process";
import { once } from "node:events";
import { existsSync, globSync, readFileSync, realpathSync, statSync } from "node:fs";
import { homedir, tmpdir } from "node:os";
import path from "node:path";
import { pathToFileURL } from "node:url";

const home = homedir();
const configPath = path.join(
  process.env.XDG_CONFIG_HOME ?? path.join(home, ".config"),
  "sbx",
  "settings.json",
);

function usage() {
  process.stdout.write(`Usage: sbx [options] [--] command [arguments...]

Run a command under the Anthropic Sandbox Runtime. The default policy allows
unrestricted reads and network access, but limits writes to the policy's roots,
the workspace, its Git metadata, /tmp, and the host temp directory.

Options:
  -w, --write DIR   Also allow writing to DIR (repeatable; symlinks resolved)
  -h, --help        Show this help

Bun removes a leading -- before the script sees it, so the separator is
optional and the first argument that is not an option starts the command. Use
-- -- for a command whose name begins with a dash.

Policy: ${configPath.replace(home, "~")} (srt's native format).
Its trustd.agent Mach lookup enables Go TLS verification; this wrapper adds
ipc-sysv-sem for pi's LMDB databases. Paths are resolved (/tmp is /private/tmp).

srt also denies writes under the launch directory to .git/hooks, .vscode/,
.idea/, .mcp.json, .claude/commands/, .claude/agents/, and shell startup files
such as .bashrc and .profile, even when they already exist; edit them outside
sbx, since no write root can reopen them.
`);
}

function parseArgs(command) {
  const writeRoots = [];
  while (command.length > 0) {
    const [arg] = command;
    if (arg === "--") {
      command.shift();
      break;
    }
    if (!arg.startsWith("-")) break;
    command.shift();
    switch (arg) {
      case "-w":
      case "--write":
        if (command.length === 0) throw new Error(`${arg} requires a directory`);
        writeRoots.push(resolvePath(command.shift()));
        break;
      case "-h":
      case "--help":
        usage();
        process.exit(0);
      default:
        throw new Error(`unknown option: ${arg}`);
    }
  }
  if (command.length === 0) throw new Error("no command specified");
  return { command, writeRoots };
}

// Seatbelt matches symlink targets, not the paths used to reach them.
function resolvePath(dir) {
  try {
    return realpathSync(dir);
  } catch {
    throw new Error(`directory does not exist: ${dir}`);
  }
}

function commandOutput(command, args) {
  return execFileSync(command, args, {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "ignore"],
  }).trim();
}

function gitDirs() {
  try {
    // A worktree needs both its own metadata and the shared repository.
    return commandOutput("git", [
      "rev-parse",
      "--path-format=absolute",
      "--git-dir",
      "--git-common-dir",
    ])
      .split("\n")
      .filter((dir) => existsSync(dir))
      .map(resolvePath);
  } catch {
    return []; // Outside a repository, the workspace is enough.
  }
}

function readPolicy(writeRoots) {
  let policy;
  try {
    policy = JSON.parse(readFileSync(configPath, "utf8"));
  } catch (error) {
    if (error.code === "ENOENT") throw new Error(`no policy at ${configPath}`);
    throw new Error(`policy is not valid JSON (${configPath}): ${error.message}`);
  }
  if (!Array.isArray(policy?.filesystem?.allowWrite)) {
    throw new Error(`policy has no filesystem.allowWrite list: ${configPath}`);
  }

  // Native APIs still use the host temp directory after srt rewrites $TMPDIR.
  policy.filesystem.allowWrite = [
    ...new Set([
      ...policy.filesystem.allowWrite,
      resolvePath(process.cwd()),
      ...gitDirs(),
      ...["/tmp", tmpdir()].filter((dir) => existsSync(dir)).map(resolvePath),
      ...writeRoots,
    ]),
  ];
  return policy;
}

function configureEnvironment(command) {
  const env = process.env;
  // Herdr sees this wrapper, not the agent it launches.
  if (path.basename(command[0]) === "pi") env.HERDR_AGENT = "pi";

  // Headless + single-process avoids Chromium's LaunchServices and Mach
  // rendezvous requirements. Prefer the most recently installed shell.
  if (!env.AGENT_BROWSER_EXECUTABLE_PATH) {
    const shells = globSync(
      path.join(
        home,
        "Library/Caches/ms-playwright/chromium_headless_shell-*/chrome-headless-shell-*/chrome-headless-shell",
      ),
    ).sort((a, b) => statSync(b).mtimeMs - statSync(a).mtimeMs);
    if (shells.length > 0) env.AGENT_BROWSER_EXECUTABLE_PATH = shells[0];
  }
  env.AGENT_BROWSER_SOCKET_DIR ??= path.join(
    env.XDG_STATE_HOME ?? path.join(home, ".local/state"),
    "agent-browser",
  );
  env.AGENT_BROWSER_ARGS = [env.AGENT_BROWSER_ARGS, "--single-process"].filter(Boolean).join(",");
}

async function main() {
  const { command, writeRoots } = parseArgs(process.argv.slice(2));
  const policy = readPolicy(writeRoots);
  configureEnvironment(command);

  // The library permits unrestricted networking; the CLI requires an allowlist.
  let installDir;
  try {
    installDir = commandOutput("mise", ["where", "npm:@anthropic-ai/sandbox-runtime"]);
  } catch {
    throw new Error("srt is required: mise use -g npm:@anthropic-ai/sandbox-runtime");
  }
  const pkg = pathToFileURL(path.join(installDir, "node_modules/@anthropic-ai/sandbox-runtime/"));
  const { SandboxManager } = await import(new URL("dist/index.js", pkg).href);
  // Use srt's quoting so arguments survive the shell layer it adds.
  const { quote } = await import(new URL("dist/utils/shell-quote.js", pkg).href);

  await SandboxManager.initialize(policy);
  const wrapped = await SandboxManager.wrapWithSandbox(quote(command));

  // LMDB needs semctl, which srt omits. Deliberately allow the host-wide
  // System V semaphore namespace, but fail closed if the profile format changes.
  const head = "sandbox-exec -p '(version 1)\n";
  if (!wrapped.includes(head)) {
    throw new Error(
      "srt no longer emits the Seatbelt profile this wrapper patches; refusing to run without the ipc-sysv-sem rule",
    );
  }

  // Keep the runtime alive for any proxies required by the policy.
  const child = spawn("/bin/bash", ["-c", wrapped.replace(head, `${head}(allow ipc-sysv-sem)\n`)], {
    stdio: "inherit",
  });
  for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) {
    process.on(signal, () => child.kill(signal));
  }
  const [code, signal] = await once(child, "exit");
  if (!signal) process.exit(code ?? 1);
  // Let the caller observe signal death without our handlers absorbing it.
  process.removeAllListeners(signal);
  process.kill(process.pid, signal);
}

main().catch((error) => {
  console.error(`sbx: ${error instanceof Error ? error.message : String(error)}`);
  process.exit(1);
});
