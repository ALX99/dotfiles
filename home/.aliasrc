#!/usr/bin/env bash
# shellcheck disable=SC1090,SC2142
# Interactive shell configuration: aliases, functions, bindings, integrations

# =============================================================================
# Short aliases
# =============================================================================
alias \
  q="exit" \
  c="clear" \
  e="\$EDITOR" \
  g='git' \
  k='kubectl' \
  mr="mise run" \
  se="sudoedit" \
  cat="bat"

# =============================================================================
# Navigation
# =============================================================================
alias \
  ..='cd ..' \
  ...='cd ../..' \
  ....='cd ../../..' \
  h='cd ~' \
  bin='cd ~/dotfiles/home/.local/bin' \
  dl='cd ~/Downloads' \
  dots='cd ~/dotfiles' \
  config='cd ~/dotfiles/home/.config'

# =============================================================================
# Better defaults
# =============================================================================
if [[ $OSTYPE != darwin* ]]; then
  alias \
    ls='command ls -hN --color=auto --group-directories-first' \
    ll='command ls -hNlA --color=auto' \
    grep='command grep --color=auto' \
    diff='command diff --color=auto' \
    df='command df --human-readable --output=source,target,size,used,avail,pcent' \
    du='command du --human-readable' \
    dd='command dd bs=512k status=progress'
else
  alias ll='ls -lhA'
fi
alias \
  ip="ip -color=auto" \
  cp="cp -i" \
  mv="mv -i" \
  rm="rm -v" \
  mkdir="mkdir -p" \
  free="free -h" \
  htop="htop -s PERCENT_CPU"

# =============================================================================
# Kubectl
# =============================================================================
# shellcheck disable=SC2154
alias \
  kgc='kubectl config current-context' \
  kgn='kubectl config get-contexts --no-headers "$(kgc)" | awk "{print \$5}" | sed "s/^$/default/"' \
  klc='yq ".contexts.[].name" ~/.kube/config' \
  kln='kubectl get namespaces -o custom-columns=NAME:.metadata.name --no-headers' \
  ksn='kubectl config set-context --current --namespace "$(kln | fzf --header "select ns. ctx: ["$(kubectl config current-context)"]")"'

# =============================================================================
# Docker
# =============================================================================
alias \
  dprune='docker system prune -a --volumes' \
  drr='docker run --rm'

# =============================================================================
# Utilities
# =============================================================================
alias \
  bye='systemctl suspend-then-hibernate' \
  utop='htop -t -u $(whoami)' \
  dlmv='mv ~/Downloads/"$(\ls -At ~/Downloads | head -n1)" .' \
  vset='_x() { read -r "$1" && export "$1"; }; _x'

# Fuzzy file picker
alias \
  pf='rg --files | fzf --preview "bat --color=always --style=numbers --line-range :200 {}"' \
  pf.='rg --files --hidden | fzf --preview "bat --color=always --style=numbers --line-range :200 {}"' \
  ef="nvim -c \"lua vim.schedule(function() require('fff').find_files({ query = '!**/.* ' }) end)\"" \
  ef.="nvim -c \"lua vim.schedule(function() require('fff').find_files() end)\""

# =============================================================================
# Functions
# =============================================================================
sd() {
  set -e
  tmp_file="$(mktemp)"
  trap 'rm -rf -- "$tmp_file"' EXIT INT TERM HUP
  sail -write-wd "$tmp_file"
  pushd "$(\cat "$tmp_file")" >/dev/null
  set +e
}

urldecode() { printf "%b" "${1//%/\\x}"; }
urlencode() { printf "%s" "$1" | jq -sRr @uri; }

# Run the Mise-installed Pi CLI with Bun instead of Node.
pi() {
  local shim target bundle cli
  shim=$(mise which pi) || return
  target=$(sed -n 's/^# aube-bin-shim v2 target=//p' "$shim")
  if [[ -z $target ]]; then
    printf 'pi: unable to read the Mise Pi shim target from %s\n' "$shim" >&2
    return 127
  fi

  bundle=$(cd "$(dirname "$shim")" &&
    python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$target") || return
  cli="${bundle%/bundle/cli.js}/cli.js"
  if [[ ! -f $cli ]]; then
    printf 'pi: unbundled CLI not found: %s\n' "$cli" >&2
    return 127
  fi

  bun --bun "$cli" "$@"
}

ksc() (
  set -euo pipefail
  s="$(klc | fzf)"
  yq e -i ".current-context = \"$s\"" ~/.kube/config
)

# =============================================================================
# Key bindings
# =============================================================================
bind -x $'"\C-l":clear;' # Ctrl+l to clear screen

command -v direnv >/dev/null 2>&1 &&
  __cached_integration direnv "$(command -v direnv)" hook bash

# =============================================================================
# External sources
# =============================================================================
_sh="${SHELL##*/}"

[ -f "/usr/share/doc/pkgfile/command-not-found.$_sh" ] && . "/usr/share/doc/pkgfile/command-not-found.$_sh"

# fzf >= 0.48 emits its shell integration inline instead of shipping script files.
command -v fzf >/dev/null 2>&1 &&
  __cached_integration fzf "$(command -v fzf)" --bash

unset _sh
