#!/usr/bin/env bash
#MISE description="Generate Karabiner-Elements config from CUE source"
#MISE aliases=["generate"]
#MISE sources=["misc/karabiner/karabiner.cue"]
#MISE outputs=[".config/karabiner/karabiner.json"]
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

generated=$(mktemp)
trap 'rm -f "$generated"' EXIT
cue export misc/karabiner/karabiner.cue --expression config --out json | jq . > "$generated"
mv "$generated" .config/karabiner/karabiner.json
trap - EXIT
