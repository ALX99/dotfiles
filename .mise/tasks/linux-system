#!/usr/bin/env bash
#MISE description="Apply imperative Linux host settings"
#MISE confirm="linux-system makes privileged host changes. Continue?"
set -euo pipefail

[[ $(uname) == Linux ]] || {
  echo 'Linux system configuration can only run on Linux.' >&2
  exit 1
}
sudo sed -i '/Color/s/^#//g' /etc/pacman.conf

sudo ln -sfT dash /usr/bin/sh

printf 'Linux system configuration completed.\n'
