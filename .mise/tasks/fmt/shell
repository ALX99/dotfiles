#!/usr/bin/env bash
#MISE description="Format shell scripts"
#MISE hide=true
set -euo pipefail
if [[ ${DOTFILES_FMT_DISPATCH:-} != fmt ]]; then
  printf '%s\n' 'Run "mise run fmt"; formatter subtasks are internal.' >&2
  exit 2
fi

git ls-files --cached --others --exclude-standard -z |
  while IFS= read -r -d '' file; do
    [[ -f $file && ! -L $file ]] || continue

    first_line=$(head -n 1 "$file")
    [[ $first_line == '#!'* ]] || continue

    interpreter=${first_line#\#!}
    interpreter=${interpreter##*env }
    interpreter=${interpreter#-S }
    interpreter=${interpreter##*/}
    interpreter=${interpreter%% *}

    case $interpreter in
    ash | bash | dash | ksh | mksh | sh | yash | zsh)
      shfmt -w -i 2 -s "$file"
      ;;
    esac
  done
