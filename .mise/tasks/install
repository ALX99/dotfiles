#!/usr/bin/env bash
#MISE description="Stow user dotfiles into $HOME and link shared agent skills"
set -euo pipefail
shopt -s nullglob

repo_dir=$(git rev-parse --show-toplevel)

in_list() {
  case " $2 " in
  *" $1 "*) return 0 ;;
  esac
  return 1
}

# Guard against rm -rf escapes: only bare top-level skill names qualify.
is_prunable_name() {
  case "$1" in
  "" | .* | */*) return 1 ;;
  esac
  return 0
}

is_repo_managed_link() {
  local link="$1" target repo_name
  [[ -L "$link" ]] || return 1
  target=$(readlink "$link")
  repo_name=${repo_dir##*/}
  [[ "$target" == "$repo_dir/"* || "$target" == "$repo_name/"* || "$target" == *"/$repo_name/"* ]]
}

# Skills owned by this repository (directory names under home/.agents/skills).
repo_skill_list=""
for skill_dir in "$repo_dir"/home/.agents/skills/*/; do
  [[ -d "$skill_dir" ]] || continue
  repo_skill_list="$repo_skill_list $(basename "$skill_dir")"
done

# Skills this repo owned at some point but no longer does (renamed/removed).
# Derived from history, so there is no manifest to keep in sync. Anything
# else in ~/.agents/skills belongs to another tool and is left alone.
retired_skill_list=""
if retired_names=$(git -C "$repo_dir" log --format= --name-only -- 'home/.agents/skills/*' 2>/dev/null | awk -F/ 'NF>4 {print $4}' | grep -v '^$' | sort -u); then
  while IFS= read -r name; do
    if [[ -n "$name" ]] && ! in_list "$name" "$repo_skill_list"; then
      retired_skill_list="$retired_skill_list $name"
    fi
  done <<<"$retired_names"
fi

kept_external_list=""
pruned_list=""

record_kept() {
  in_list "$1" "$kept_external_list" || kept_external_list="$kept_external_list $1"
}

record_pruned() {
  in_list "$1" "$pruned_list" || pruned_list="$pruned_list $1"
}

sync_agents_skills() {
  local agents_dir="$HOME/.agents/skills"
  mkdir -p "$agents_dir"

  local link link_name skill_dir skill_name link_path entry entry_name
  # Drop symlinks left behind by renamed/removed repo skills.
  while IFS= read -r -d '' link; do
    link_name=$(basename "$link")
    if is_repo_managed_link "$link" && ! in_list "$link_name" "$repo_skill_list"; then
      printf 'Removing stale repo skill link: %s -> %s\n' "$link" "$(readlink "$link")"
      record_pruned "$link_name"
      rm -f "$link"
    fi
  done < <(find "$agents_dir" -mindepth 1 -maxdepth 1 -type l -print0 2>/dev/null)

  # Every repo skill must be a directory symlink into the repo, so dotfile
  # edits take effect. Anything else at that path is replaced.
  for skill_dir in "$repo_dir"/home/.agents/skills/*/; do
    [[ -d "$skill_dir" ]] || continue
    skill_name=$(basename "$skill_dir")
    link_path="$agents_dir/$skill_name"
    if [[ -L "$link_path" && $(readlink "$link_path") == "$skill_dir" ]]; then
      continue
    fi
    if [[ -e "$link_path" || -L "$link_path" ]]; then
      printf 'Replacing with repo symlink: %s\n' "$link_path"
      rm -rf "$link_path"
    fi
    printf 'Linking: %s -> %s\n' "$link_path" "$skill_dir"
    ln -s "$skill_dir" "$link_path"
  done

  # Remove leftovers of renamed/removed repo skills. Everything else —
  # skills installed by other tools, manual links — is left alone.
  while IFS= read -r -d '' entry; do
    entry_name=$(basename "$entry")
    is_prunable_name "$entry_name" || continue
    in_list "$entry_name" "$repo_skill_list" && continue
    if in_list "$entry_name" "$retired_skill_list"; then
      # A foreign link reusing a retired name is still the owner's; keep it.
      if [[ -L "$entry" ]] && ! is_repo_managed_link "$entry"; then
        record_kept "$entry_name"
        continue
      fi
      printf 'Removing retired skill: %s\n' "$entry"
      record_pruned "$entry_name"
      rm -rf "$entry"
    else
      record_kept "$entry_name"
    fi
  done < <(find "$agents_dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
}

sync_claude_skills() {
  local agents_dir="$HOME/.agents/skills" claude_dir="$HOME/.claude/skills"
  mkdir -p "$claude_dir"

  local link name target target_name src src_name link_path link_target
  # Drop mirror links whose agents counterpart is gone, and stale
  # repo-managed links for removed skills.
  while IFS= read -r -d '' link; do
    name=$(basename "$link")
    target=$(readlink "$link")
    if is_repo_managed_link "$link"; then
      if ! in_list "$name" "$repo_skill_list"; then
        printf 'Removing stale repo skill link: %s -> %s\n' "$link" "$target"
        record_pruned "$name"
        rm -f "$link"
      fi
    elif [[ "$target" == "../../.agents/skills/"* ]]; then
      target_name=$(basename "$target")
      if ! is_prunable_name "$target_name" || [[ ! -e "$agents_dir/$target_name" ]]; then
        printf 'Removing orphaned Claude skill link: %s -> %s\n' "$link" "$target"
        record_pruned "$name"
        rm -f "$link"
      fi
    fi
  done < <(find "$claude_dir" -mindepth 1 -maxdepth 1 -type l -print0 2>/dev/null)

  # Mirror every agents skill; never replace real entries owned by other tools.
  for src in "$agents_dir"/*; do
    [[ -d "$src" ]] || continue
    src_name=$(basename "$src")
    is_prunable_name "$src_name" || continue
    link_path="$claude_dir/$src_name"
    link_target="../../.agents/skills/$src_name"
    if [[ -L "$link_path" && $(readlink "$link_path") == "$link_target" ]]; then
      continue
    fi
    if [[ -e "$link_path" || -L "$link_path" ]]; then
      printf 'Skipping existing Claude path (not a stale link): %s\n' "$link_path"
      continue
    fi
    printf 'Linking: %s -> %s\n' "$link_path" "$link_target"
    ln -s "$link_target" "$link_path"
  done
}

mkdir -p "$HOME/.config" "$HOME/.local" "$HOME/.agents/skills" "$HOME/.claude/skills"

sync_agents_skills

stow --dir "$repo_dir" --target "$HOME/.local" --restow .local
stow --dir "$repo_dir" --target "$HOME" --restow home

sync_claude_skills

repo_skill_count=$(wc -w <<<"$repo_skill_list")
printf 'Agent skills: %d repo-linked; external kept:%s; pruned:%s\n' \
  "$repo_skill_count" "${kept_external_list:- none}" "${pruned_list:- none}"

stow --dir "$repo_dir" --target "$HOME/.config" --restow .config

if command -v herdr >/dev/null 2>&1 &&
   [[ -d "$HOME/.config/herdr/plugins" ]]; then
  for plugin_dir in "$HOME/.config/herdr/plugins"/*/; do
    [[ -f "$plugin_dir/herdr-plugin.toml" ]] || continue
    herdr plugin link "$plugin_dir" --enabled >/dev/null
  done
fi

if [[ $(uname) == Linux ]] &&
   command -v systemctl >/dev/null 2>&1 &&
   [[ -n ${XDG_RUNTIME_DIR:-} && -S "$XDG_RUNTIME_DIR/bus" ]] &&
   systemctl --user show-environment >/dev/null 2>&1; then
  systemctl --user enable --now ssh-agent
fi

if [[ ! -d "$HOME/.pi/agent/extensions/node_modules" ]]; then
  printf "Hint: run 'mise run pi:deps' to install pi extension dependencies\n"
fi

printf 'User configuration completed.\n'
