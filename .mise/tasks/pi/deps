#!/usr/bin/env bash
#MISE description="Install pi extension dependencies (node_modules from lockfile)"
#MISE dir="home/.pi/agent/extensions"
#MISE sources=["pnpm-lock.yaml", "package.json"]
#MISE outputs=["node_modules"]
#MISE aliases=["install-pi"]
set -euo pipefail

pnpm install --frozen-lockfile

# Pi loads extensions through jiti resolving from ~/.pi/agent/extensions, whose
# manifest and lockfile are symlinks into this directory. That tree therefore
# needs its own install of the same dependency set, or extension imports fail.
runtime_dir="$HOME/.pi/agent/extensions"
if [[ -d $runtime_dir ]]; then
  pnpm --dir "$runtime_dir" install --frozen-lockfile
fi
