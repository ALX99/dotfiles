  <ns0:metadata>
    <ns0:name>Arashiyama–Hozukyo–Atagoyama–Kiyotaki</ns0:name>
    <ns0:desc>Planned route assembled from YAMAP official model course 20555 and official map lines, cross-checked with public YAMAP activities 49660845, 49758465, 48057450, 45253514, 48047102, and 49394503. The Atago-mae Viewpoint spur uses a public recorded walking track because it is outside YAMAP official hiking geometry.</ns0:desc>
    <ns0:link href="https://yamap.com/model-courses/20555">
      <ns0:text>YAMAP official model course 20555</ns0:text>
    </ns0:link>
    <ns0:link href="https://yamap.com/activities/49660845">
      <ns0:text>Public YAMAP approach activity</ns0:text>
    </ns0:link>
    <ns0:link href="https://yamap.com/activities/49758465">
      <ns0:text>Public YAMAP Kiyotaki–Hozukyo activity</ns0:text>
    </ns0:link>
    <ns0:link href="https://netlog.jpn.org/r271-635/2021/11/nisonin-kiyotaki-hozukyou.html">
      <ns0:text>Recorded viewpoint-spur reference</ns0:text>
    </ns0:link>
